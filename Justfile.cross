# settings
set export := true
set positional-arguments

CROSSFILE := "Crossfile"
CROSSDIR := ".cross"
METADATA := "$CROSSDIR/metadata.json"
JUST_DIR := env("JUST_DIR", source_dir())
REPO_DIR := env ("REPO_DIR", "$(git rev-parse --show-toplevel)")
SHELL := env("SHELL")

# Auto-setup environment on first use
# AICONTEXT: Optional target to help user to ensure correct setup for tool usage. Taks: Call direnv, loading .envrc and from that .env file. Ideally short implementation. 
setup:
    #!/usr/bin/env fish
    # Check if direnv is available
    if command -v direnv >/dev/null; and test -f .envrc
        if not direnv status | grep -q "Found RC allowed true"
            direnv allow .
        end
    end

# AICONTEXT: Implemented through just -l option. Use comment strings on individual targets to document ussage.
# Show this help message
help:
   just -l

# AICONTEXT: This is for AI tools to execute tests in sanbox environment. Do not change implementation!
# Run test suite in clean environment (optional args: [test_id]: 01, 02, etc)
test *ARGS:
    #!/usr/bin/env bash
    # PRESERVE THESE ENVS
    THOME="$HOME"
    TUSER="$USER"
    TPATH="$PATH"
    TTERM="$TERM"
    BASH="$(command -v bash)"

    if [[ "${1:-}" == "shell" ]]; then
        shift || true
        just --justfile "{{JUST_DIR}}/Justfile.cross" test-shell {{ARGS}}
        exit 0
    fi

    # Run in clean environment with minimal PATH
    #TARG="${ARGS:+--test $ARGS}"
    env -i \
        TARG="$TARG" \
        HOME="$THOME" \
        USER="$TUSER" \
        PATH="$TPATH" \
        SHELL="$BASH" \
        TERM="${TTERM:-xterm}" \
        GIT_CONFIG_NOSYSTEM=1 \
        GIT_CONFIG_GLOBAL=/dev/null \
        "$BASH" --norc --noprofile -c 'cd "{{JUST_DIR}}"; ./test/run-all.sh {{ARGS}}';
    STATUS=$?
    echo "Test exited with $STATUS";
    exit $STATUS

# AICONTEXT: This is for AI tools to execute tests in sanbox environment. Do not change implementation!
# Run "test" shell environment or commands passed as ARGS inside "test shell environment"
test-shell *ARGS="bash":
    #!/usr/bin/env bash
    set -euo pipefail
    THOME="$HOME"
    TUSER="$USER"
    TPATH="$PATH"
    TTERM="$TERM"
    BASH="$(command -v bash)"

    if [[ -t 0 && -t 1 ]]; then
        echo 'Launching git-cross test shell (type CTRL+D to leave)...'
        env -i \
            HOME="$THOME" \
            USER="$TUSER" \
            PATH="$TPATH" \
            SHELL="$BASH" \
            TERM="${TTERM:-xterm}" \
            "$BASH" --norc --noprofile -i -c "{{ARGS}}"
    fi

# AICONTEXT: This methond validate user workspace has installed all required dependencies. Dont install them, but prints how-to.
# Check for required dependencies
check-deps:
    #!/usr/bin/env fish
    set -l missing
    for cmd in fish rsync git jq rg
        if not command -v $cmd > /dev/null
            set missing $missing $cmd
        end
    end
    if test (count $missing) -gt 0
        just cross _log error "Missing: $missing"
        just cross _log info "Install the missing binaries with your package manager."
        exit 1
    end


# AICONTEXT: This is new and better implementation of resolve_context
# Internal: resolve patch metadata from path argument or CWD
[no-cd] # to be able to set CWD as $path if not provided
_resolve_context2 path="": check-initialized
    #!/usr/bin/env fish

    # Resolve git repo relative path of target
    if test "$path" = "." -o "$path" = "./"
        # "." means the caller's directory — same as no path
        set path ""
    end
    if test -z "$path"
        # Use USER_CWD (set by root Justfile cross recipe) to preserve caller's CWD
        if test -n "$USER_CWD" -a -n "$REPO_DIR"
            set -x path (realpath --relative-to="$REPO_DIR" "$USER_CWD" 2>/dev/null; or echo "")
            # "." means we're at repo root — treat as empty
            if test "$path" = "."
                set -x path ""
            end
        end
        if test -z "$path"
            set -x path "$(git rev-parse --show-prefix | sed 's,\/$,,')"
        end
    end
    if test -z "$path"
        just cross _log error "Provide path to 'patch' or change directory into it."
        exit 1
    end
    # Query metadata.json and export matching key as env variables
    # Find patch whose local_path is a prefix of (or equal to) the given path
    # i.e. path starts with local_path — handles both exact match and subdirectory cases.
    # Paths are normalized ("^\\./" stripped) so "./mxc2" in metadata still matches "mxc2".
    jq -r --arg path "$path" '
        .patches
        | map(. as $patch
              | ($patch.local_path | ltrimstr("./")) as $lp
              | select(($path | ltrimstr("./")) | startswith($lp))
              | $patch + {mlen: ($lp | length)})
        | max_by(.mlen)
        | select(. != null)
        | del(.mlen)
        | to_entries | map("set -x \(.key) \(.value|@sh)") | .[]
        ' "{{REPO_DIR}}/{{METADATA}}"

# AICONTEXT: This method updates Crossfile, an configuration file for git-cross. Do not change implementation!
# Internal: append command to Crossfile (avoiding duplicates)
update_crossfile +cmd:
    grep -qF "{{cmd}}" "{{CROSSFILE}}" 2>/dev/null || echo "{{cmd}}" >> "{{CROSSFILE}}"; exit 0

[no-cd]
_crossignore_patterns local_dir:
    #!/usr/bin/env fish
    set -l file "{{local_dir}}/.crossignore"
    if not test -f "$file"
        exit 0
    end
    while read -l line
        set -l trimmed (string trim -- "$line")
        if test -n "$trimmed"; and not string match -q '#*' -- "$trimmed"
            printf '%s\n' "$trimmed"
        end
    end < "$file"

[no-cd]
_crossignore_match pattern rel_path:
    #!/usr/bin/env fish
    set -l normalized (string trim -r -c '/' -- "{{pattern}}")
    if test -z "$normalized"
        exit 1
    end
    if string match -q '*/*' -- "$normalized"
        if test "{{rel_path}}" = "$normalized"; or string match -q -- "$normalized/*" "{{rel_path}}"
            printf '%s\n' "$normalized"
            exit 0
        end
        exit 1
    end

    set -l parts (string split / -- "{{rel_path}}")
    for idx in (seq (count $parts))
        if string match -q -- "$normalized" "$parts[$idx]"
            string join / $parts[1..$idx]
            exit 0
        end
    end
    exit 1

[no-cd]
_crossignore_overrides local_dir:
    #!/usr/bin/env fish
    set -l patterns (just cross _crossignore_patterns "{{local_dir}}")
    if test (count $patterns) -eq 0
        exit 0
    end

    set -l matches
    set -l entries (find "{{local_dir}}" -mindepth 1 -not -path '*/.git/*' -print0 | string split0)
    for line in $entries
        set -l rel (realpath --relative-to="{{local_dir}}" "$line")
        for pattern in $patterns
            set -l match_path (just cross _crossignore_match "$pattern" "$rel" 2>/dev/null)
            if test -n "$match_path"
                contains -- "$match_path" $matches; or set matches $matches "$match_path"
                break
            end
        end
    end
    printf '%s\n' $matches

# Internal: Log message with color
_log level +message:
    #!/usr/bin/env fish
    set color_reset (set_color normal)
    switch {{level}}
        case info
            set color (set_color blue)
            echo "$color==> {{message}}$color_reset"
        case success
            set color (set_color green)
            echo "$color==> {{message}}$color_reset"
        case warn
            set color (set_color yellow)
            echo "$color==> WARNING: {{message}}$color_reset"
        case error
            set color (set_color red)
            echo "$color==> ERROR: {{message}}$color_reset" >&2
        case '*'
            echo "==> {{message}}"
    end

# Print one row per patch: local_path<TAB>worktree (machine-parseable).
# hint is variadic because the Justfile wrapper word-splits arguments.
[no-cd]
_list_patches *hint="":
    #!/usr/bin/env fish
    if not test -f "{{REPO_DIR}}/.cross/metadata.json"
        just cross _log info "No patches configured."
        exit 0
    end
    set -l hint_text "{{hint}}"
    if test -n "$hint_text"
        echo "$hint_text" >&2
    end
    jq -r '.patches[] | "\(.local_path)\t\(.worktree)"' "{{REPO_DIR}}/.cross/metadata.json"

# Interactive patch selection; prints the selected local_path.
# Cancels silently (empty output). If fzf is missing: rows+hint to stderr, exit 1.
[no-cd]
_select_patch *prompt="patch":
    #!/usr/bin/env fish
    if not command -v fzf >/dev/null 2>&1
        just cross _list_patches "fzf is not installed, cd into a patched directory first or pass a path. Patches, columns local_path TAB worktree" >&2
        exit 1
    end
    set -l row (just cross _list_patches | fzf --height 40% --select-1 --exit-0 --prompt "Select {{prompt}}> ")
    test -z "$row"; and exit 0
    set -l cols (string split \t -- $row)
    echo "$cols[1]"

# Initialize a new project with Crossfile
[no-cd]
init:
    #!/usr/bin/env fish
    if test -f "{{CROSSFILE}}"
        just cross _log info "Crossfile already exists."
    else
        echo "# git-cross configuration" > "{{CROSSFILE}}"
        just cross _log success "Crossfile initialized."
    end

# AICONTEXT: "use" register remote git repository and update Crossfile with "use" command. Do not change implementation!
# Add a remote repository
[no-cd]
use name url: check-deps
    #!/usr/bin/env fish
    cd "{{REPO_DIR}}" &&\
    if not git remote show {{name}} >/dev/null 2>&1
        git remote add {{name}} {{url}}
        # Detect default branch
        git ls-remote --heads {{url}} 2>/dev/null \
        && just cross update_crossfile "cross use {{name}} {{url}}"
    end

# Remove a patch and its worktree
[no-cd]
remove path: check-deps
    #!/usr/bin/env fish
    set l_path (path normalize "{{path}}")
    pushd "{{REPO_DIR}}"
        if not test -f {{METADATA}}
            just cross _log error "No metadata found."
            exit 1
        end

        set entry (jq -r --arg lp "$l_path" '.patches[] | select((.local_path | ltrimstr("./")) == $lp)' {{METADATA}})
        if test -z "$entry"
            just cross _list_patches "No patch detected, available patches, columns local_path TAB worktree"
            just cross _log error "Patch not found for path: $l_path"
            exit 1
        end

        set wt (echo "$entry" | jq -r '.worktree')

        just cross _log info "Removing patch at $l_path..."

        # 1. Remove worktree
        if test -d "$wt"
            just cross _log info "Removing git worktree at $wt..."
            git worktree remove --force "$wt"
        end

        # 2. Remove from Crossfile (match patch lines where last field is the local_path)
        just cross _log info "Removing from Crossfile..."
        if test -f "{{CROSSFILE}}"
            set tmp (mktemp)
            while read -l line
                # Only remove lines that are patch commands with this exact local_path as last field
                set fields (string split ' ' -- (string trim $line))
                set is_patch false
                for f in $fields
                    test "$f" = "patch" && set is_patch true
                end
                if test "$is_patch" = true -a (count $fields) -gt 0 -a (path normalize "$fields[-1]") = "$l_path"
                    continue  # skip this line
                end
                echo "$line" >> "$tmp"
            end < "{{CROSSFILE}}"
            mv "$tmp" "{{CROSSFILE}}"
        end

        # 3. Update metadata
        just cross _log info "Updating metadata..."
        set tmp_meta (mktemp)
        jq --arg lp "$l_path" '.patches |= map(select((.local_path | ltrimstr("./")) != $lp))' {{METADATA}} > "$tmp_meta"
        mv "$tmp_meta" {{METADATA}}

        # 4. Remove local directory (with root guard)
        if test "$l_path" != "." -a -n "$l_path"
            just cross _log info "Deleting local directory $l_path..."
            rm -rf "$l_path"
        end

        just cross _log success "Patch removed successfully."
    popd

# Prune unused remotes and worktrees, or remove all patches for a specific remote
prune remote_name="": check-deps
    #!/usr/bin/env fish
    set remote "{{remote_name}}"
    pushd "{{REPO_DIR}}"
        if not test -f {{METADATA}}
            just cross _log error "No metadata found."
            exit 1
        end

        if test -n "$remote"
            # Prune specific remote: remove all its patches
            just cross _log info "Pruning all patches for remote: $remote..."
            
            # Get all patches for this remote
            set patches (jq -r --arg remote "$remote" '.patches[] | select(.remote == $remote) | .local_path' {{METADATA}})
            
            if test -z "$patches"
                just cross _log warn "No patches found for remote: $remote"
            else
                # Remove each patch
                for patch_path in $patches
                    just cross _log info "Removing patch: $patch_path"
                    just cross remove "$patch_path"
                end
            end
            
            # Remove the remote itself
            if git remote | grep -q "^$remote\$"
                just cross _log info "Removing git remote: $remote"
                git remote remove "$remote"
            end
            
            just cross _log success "Remote $remote and all its patches pruned successfully."
        else
            # Prune all unused remotes (no active patches)
            just cross _log info "Finding unused remotes..."
            
            # Get all remotes used by patches
            set used_remotes (jq -r '.patches[].remote' {{METADATA}} | sort -u)
            
            # Get all git remotes (except origin and git-cross)
            set all_remotes (git remote | grep -v "^origin\$" | grep -v "^git-cross\$")
            
            # Find unused remotes
            set unused_remotes
            for remote in $all_remotes
                if not contains $remote $used_remotes
                    set unused_remotes $unused_remotes $remote
                end
            end
            
            if test -z "$unused_remotes"
                just cross _log info "No unused remotes found."
            else
                just cross _log info "Unused remotes: $unused_remotes"
                read -P "Remove these remotes? [y/N]: " confirm
                
                if test "$confirm" = "y"; or test "$confirm" = "Y"
                    for remote in $unused_remotes
                        just cross _log info "Removing remote: $remote"
                        git remote remove "$remote"
                    end
                    just cross _log success "Unused remotes removed."
                else
                    just cross _log info "Pruning cancelled."
                end
            end
            
            # Always prune stale worktrees
            just cross _log info "Pruning stale worktrees..."
            git worktree prune --verbose

            # Clean orphaned .cross/worktrees/ directories not referenced in metadata
            if test -d .cross/worktrees
                set known_wts (jq -r '.patches[].worktree' {{METADATA}} 2>/dev/null)
                for wt_dir in .cross/worktrees/*/
                    set wt_dir (string trim -r -c '/' "$wt_dir")
                    if not contains "$wt_dir" $known_wts
                        just cross _log info "Removing orphaned worktree directory: $wt_dir"
                        rm -r "$wt_dir"
                    end
                end
            end

            just cross _log success "Worktree pruning complete."
        end
    popd

# Sparse-checkout an upstream path into a local directory and record it in Crossfile.
# AICONTEXT: for implementation, use "fish" keep it simple, shell comamnds shall be readable. Ideally keep bellow 30 lines. User interaction shall be kept minimal. Debug statements are not needed. Document in comments major logical blocks.
# Patch a directory from a remote into a local path
patch remote_spec local_path="": check-deps
    #!/usr/bin/env fish
    set parts (string split : {{remote_spec}})
    switch (count $parts)
        case 3
            set remote $parts[1]
            set remote_branch $parts[2]
            set remote_path $parts[3]
        case 2
            set remote $parts[1]
            set remote_path $parts[2]
        case '*'
            just cross _log error "Error: Invalid format. Use remote[:branch]:remote_path LOCAL_PATH"
            exit 1
    end

    # update vars — treat "/" as "." (whole repo root)
    set r_path (string trim -c '/' -- "$remote_path")
    test -n "$r_path"; or set r_path "."

    set l_path "{{local_path}}"
    if test -z "$l_path" -a "$r_path" = "."
        just cross _log error "Error: local_path is required when patching whole repo, path is '.'"
        exit 1
    end
    test -n "$l_path"; or set l_path "$r_path"
    # Normalize the local path so "./mxc2" is stored/matched as "mxc2"
    set l_path (path normalize "$l_path")

    pushd "{{REPO_DIR}}"
    
        # validate remote   
        if not git remote show $remote |grep -vq "^$remote\$" 
            just cross _log error "Error: Remote $remote not found. Run: just cross use $remote URL"
            exit 1
        end

        # validate target branch
        if test -z "$remote_branch"
            set remote_branch "master"
            if git ls-remote --heads $remote | grep -q "refs/heads/main"
                set remote_branch "main"
            end
        end
        
        # calculate hash/id — must match Go/Rust: SHA256(remote\0remote_path\0branch)[:8]
        set hash (printf '%s\0%s\0%s' $remote $r_path $remote_branch | sha256sum 2>/dev/null; or printf '%s\0%s\0%s' $remote $r_path $remote_branch | shasum -a 256)
        set hash (echo $hash | cut -d' ' -f1 | string sub -l 8)
        set wt ".cross/worktrees/$remote"_"$hash"
        
        # setup worktree
        just cross _log info "Setting up worktree at $wt..."
        if not test -d $wt
            mkdir -p (dirname $wt)
            git fetch $remote $remote_branch
            git worktree add --no-checkout -B "cross/$remote/$remote_branch/$hash" $wt "$remote/$remote_branch" >/dev/null 2>&1

            if test "$r_path" = "."
                # Whole-repo patch: skip sparse-checkout, do full checkout
                git -C $wt read-tree -mu HEAD
            else
                # Sparse checkout — trailing "/" ensures gitignore-style pattern
                # reliably matches the directory in --no-cone mode.
                git -C $wt sparse-checkout init --no-cone
                git -C $wt sparse-checkout set "$r_path/"
                # read-tree explicitly populates worktree (bare checkout can no-op after --no-checkout)
                git -C $wt read-tree -mu HEAD
            end
        end

        # sync to local_path
        just cross _log info "Syncing files to $l_path..."
        mkdir -p $l_path
        rsync -av --delete --exclude .git $wt/$r_path/ $l_path/

        # Ensure .cross/ is in .gitignore
        if not grep -qxF '.cross/' .gitignore 2>/dev/null
            if test -f .gitignore; and test -s .gitignore; and not string match -q '' (tail -c1 .gitignore)
                echo '' >> .gitignore
            end
            echo '.cross/' >> .gitignore
        end

        # Add local_path to git
        git add $l_path
        
        # update Crossfile
        just cross _log info "Update Crossfile"
        just cross update_crossfile "cross patch $remote:$remote_branch:$r_path $l_path"

        # Initialize metadata.json
        if not test -f {{METADATA}}
            mkdir -p (dirname {{METADATA}})
            echo '{"patches": []}' > {{METADATA}}
        end
        # Update metadata.json
        set new_entry "{\"id\": \"$hash\", \"remote\": \"$remote\", \"remote_path\": \"$r_path\", \"local_path\": \"$l_path\", \"worktree\": \"$wt\", \"branch\": \"$remote_branch\"}"
        # 1. Delete existing entry with same id (if any)
        # 2. Append new entry
        set tmp_file (mktemp)
        ## AICONTEXT: use direct update with jq instead the temp file
        jq ".patches |= map(select(.id != \"$hash\")) + [$new_entry]" "{{METADATA}}" > "$tmp_file"
        mv "$tmp_file" "{{METADATA}}"
        
    popd

[no-cd]
@check-initialized:
    cd {{REPO_DIR}} && test -d {{CROSSDIR}}/worktrees && test -f {{METADATA}} \
        || { just cross _log warn "No patches to update" >&2; exit 0; }

# Update Crossfile-managed patches from upstream. Local edits are preserved and
# left for manual review against the refreshed sparse worktree.
[no-cd]
_update_patch spec local_path:
    #!/usr/bin/env fish
    # Normalize the local path so "./mxc2" in Crossfile matches "mxc2" in metadata
    set l_path (path normalize "{{local_path}}")
    if test "$l_path" = "."
        just cross _log error "Updating a repository-root patch is not supported safely yet."
        exit 1
    end
    pushd "{{REPO_DIR}}" >/dev/null
    set fields (string split ':' -- "{{spec}}")
    set remote $fields[1]
    set remote_path (string trim -c '/' -- $fields[-1])
    test -n "$remote_path"; or set remote_path "."
    set entry (jq -c --arg lp "$l_path" '.patches[]? | select((.local_path | ltrimstr("./")) == $lp)' {{METADATA}} 2>/dev/null)
    if test -z "$entry"
        if test -e "{{REPO_DIR}}/$l_path"
            just cross _log error "Local path already exists but is not registered, refusing to overwrite it: $l_path"
            exit 1
        end
        just cross patch "{{spec}}" "$l_path"
        exit $status
    end
    set wt (echo "$entry" | jq -r '.worktree')
    set branch (echo "$entry" | jq -r '.branch')
    set entry_remote (echo "$entry" | jq -r '.remote')
    set entry_remote_path (echo "$entry" | jq -r '.remote_path')
    if test "$remote" != "$entry_remote" -o "$remote_path" != "$entry_remote_path"
        just cross _log error "Crossfile source changed for $l_path, remove and patch it explicitly before updating."
        exit 1
    end
    set spec_parts (string split ':' -- "{{spec}}")
    if test (count $spec_parts) -eq 3 -a "$spec_parts[2]" != "$branch"
        just cross _log error "Crossfile branch changed for $l_path, remove and patch it explicitly before updating."
        exit 1
    end
    set local_abs "{{REPO_DIR}}/$l_path"
    set wt_abs "{{REPO_DIR}}/$wt/$remote_path"
    # Detect local edits with an rsync itemized dry-run (excludes .git, the
    # worktree's pointer file never exists in the local copy).
    set local_changed false
    if test -d "$local_abs"
        set itemized (rsync -rlcn --delete --exclude=.git --itemize-changes "$wt_abs/" "$local_abs/")
        set rsync_status $status
        if test $rsync_status -ne 0
            just cross _log error "Could not compare local path and worktree."
            exit 1
        end
        if test (count $itemized) -gt 0
            set local_changed true
        end
    end
    git fetch $remote $branch; or exit 1
    set fetched_commit (git rev-parse FETCH_HEAD); or exit 1
    set worktree_dirty (git -C "$wt" status --porcelain)
    if test -n "$worktree_dirty"
        just cross _log error "Worktree has manual changes, leaving it untouched: $wt"
        exit 1
    end
    git -C "$wt" merge --ff-only "$fetched_commit"; or begin
        just cross _log error "Upstream cannot fast-forward the worktree. Review it manually: $wt"
        exit 1
    end
    if test "$local_changed" = "true"
        just cross _log warn "'$l_path' differs from upstream; local copy preserved. Compare with: git cross diff $l_path"
        exit 0
    end
    mkdir -p "$local_abs"
    rsync -av --delete --exclude .git "$wt_abs/" "$local_abs/"

# Update declarations in Crossfile. Only use and patch lines are interpreted.
[no-cd]
update path="": check-deps
    #!/usr/bin/env fish
    if not test -f "{{REPO_DIR}}/Crossfile"
        just cross _log error "Crossfile not found."
        exit 1
    end
    pushd "{{REPO_DIR}}" >/dev/null
    set updates 0
    while read -l line
        set fields (string split -n ' ' -- (string trim -- "$line"))
        if test (count $fields) -eq 0; or string match -q '#*' -- $fields[1]
            continue
        end
        if test "$fields[1]" = "git" -o "$fields[1]" = "just"
            if test (count $fields) -lt 3 -o "$fields[2]" != "cross"
                just cross _log error "Unsupported Crossfile command: $line"
                exit 1
            end
            set fields $fields[3..-1]
        else if test "$fields[1]" = "cross"
            set fields $fields[2..-1]
        end
        if test "$fields[1]" = "use"
            if test (count $fields) -ne 3
                just cross _log error "Invalid use declaration in Crossfile: $line"
                exit 1
            end
            just cross use $fields[2] $fields[3]; or exit 1
            git fetch $fields[2]; or exit 1
        else if test "$fields[1]" = "patch"
            if test (count $fields) -lt 2 -o (count $fields) -gt 3
                just cross _log error "Invalid patch declaration in Crossfile: $line"
                exit 1
            end
            set remote_path (string split ':' -- "$fields[2]")[-1]
            set local_path $remote_path
            if test (count $fields) -ge 3
                set local_path $fields[3]
            end
            test -n "$local_path"; or set local_path "."
            # Normalize so "./mxc2" and "mxc2" identify the same patch
            set local_path (path normalize "$local_path")
            if test -n "{{path}}"
                set filter_path (path normalize "{{path}}")
                if test "$local_path" != "$filter_path"
                    continue
                end
            end
            just cross _update_patch $fields[2] $local_path; or exit 1
            set updates (math $updates + 1)
        else
            just cross _log error "Unsupported Crossfile command: $line. update supports use and patch only"
            exit 1
        end
    end < "{{REPO_DIR}}/Crossfile"
    if test -n "{{path}}" -a $updates -eq 0
        just cross _log error "No Crossfile patch found for {{path}}"
        exit 1
    end
    popd >/dev/null

# Diff local vs upstream
[no-cd]
diff path="": check-initialized
    #!/usr/bin/env fish
    
    set resolved_path "{{path}}"
    
    # If path provided, resolve to repo-relative
    if test -n "$resolved_path"
        pushd "{{REPO_DIR}}" >/dev/null
            # Check if path is a directory or file
            if test -e "$resolved_path"
                # cd to the path (or its directory) and get repo-relative location
                if test -d "$resolved_path"
                    set resolved_path (cd "$resolved_path" && git rev-parse --show-prefix | sed 's,/$,,')
                else
                    # Handle file path - get directory
                    set dir (dirname "$resolved_path")
                    set resolved_path (cd "$dir" && git rev-parse --show-prefix | sed 's,/$,,')
                end
            else
                just cross _log error "Error: Path does not exist: $resolved_path"
                exit 1
            end
        popd >/dev/null
    end

    # Resolve metadata: explicit path, CWD auto-detect, then fzf selection.
    # An empty resolution means either no path/target or no matching patch.
    set -l ctx (just cross _resolve_context2 "$resolved_path" 2>/dev/null)
    if test (count $ctx) -eq 0
        if test -z "$resolved_path"
            if not command -v fzf >/dev/null 2>&1
                just cross _list_patches "fzf is not installed, cd into a patched directory first or pass a path. Patches, columns local_path TAB worktree"
                exit 1
            end
            set -l sel (just cross _select_patch patch)
            test -z "$sel"; and exit 0
            set resolved_path "$sel"
            set ctx (just cross _resolve_context2 "$sel" 2>/dev/null)
        end
        if test (count $ctx) -eq 0
            just cross _list_patches "No patch detected, available patches, columns local_path TAB worktree"
            exit 1
        end
    end
    printf '%s\n' $ctx | source

    pushd "{{REPO_DIR}}"  
        if test -d $worktree
            set overrides (just cross _crossignore_overrides "{{REPO_DIR}}/$local_path")
            if test -z "$overrides[1]"
                # Exclude .git (worktree pointer file has no local counterpart) while
                # keeping real content diffs and the difference exit status.
                git diff --no-index $worktree/$remote_path $local_path -- ':(exclude).git' ':(glob)**' || true
            else
                for override in $overrides
                    printf 'git diff --no-index "%s" "%s"\n' "{{REPO_DIR}}/$worktree/$remote_path/$override" "{{REPO_DIR}}/$local_path/$override"
                end
            end
        else
            just cross _log error "Error: Worktree not found $worktree"
            exit 1
        end
    popd

# Open the configured directory comparison tool (git config cross.diffTool).
[no-cd]
compare path="": check-initialized
    #!/usr/bin/env fish
    # cross.diffTool may contain {left}/{right} placeholders (repo-relative paths);
    # without placeholders the paths are appended as arguments (legacy form).
    # Resolve metadata: explicit path, CWD auto-detect, then fzf selection
    set -l ctx (just cross _resolve_context2 "{{path}}" 2>/dev/null)
    if test (count $ctx) -eq 0
        if test -z "{{path}}"
            if not command -v fzf >/dev/null 2>&1
                just cross _list_patches "fzf is not installed, cd into a patched directory first or pass a path. Patches, columns local_path TAB worktree"
                exit 1
            end
            set -l sel (just cross _select_patch patch)
            test -z "$sel"; and exit 0
            set ctx (just cross _resolve_context2 "$sel" 2>/dev/null)
        end
        if test (count $ctx) -eq 0
            just cross _list_patches "No patch detected, available patches, columns local_path TAB worktree"
            exit 1
        end
    end
    printf '%s\n' $ctx | source

    set tool (git config --get cross.diffTool 2>/dev/null)
    test -n "$tool"; or set tool "vim \"+DirDiffIgnore='.git' DirDiff {left} {right}\""
    set left "$worktree/$remote_path"
    set right "$local_path"
    if string match -q "*{left}*" -- $tool; or string match -q "*{right}*" -- $tool
        set cmd (string replace -a '{right}' "$right" "$tool")
        set cmd (string replace -a '{left}' "$left" "$cmd")
        pushd "{{REPO_DIR}}" >/dev/null
        bash -c "$cmd"
        popd >/dev/null
    else
        bash -c "$tool \"\$1\" \"\$2\"" cross-compare "{{REPO_DIR}}/$left" "{{REPO_DIR}}/$right"
    end

# Alias for: compare
[no-cd]
cmp path="": (compare path)

# AICONTEXT: "list" lists remotes used by patches and all patches from .cross/metadata.json
# (worktrees live under .cross/worktrees/). raw: TSV rows with no banners/borders;
# no_header: omit header lines. Output order is fixed: remotes first, then patches.
# Usage: list [raw] [no_header]  (e.g. `just cross list 1`, `just cross list raw=1 no_header=1`)
# List all remotes and patches
[no-cd]
list raw="" no_header="": check-deps
    #!/usr/bin/env fish
    # just binds recipe parameters positionally; tolerate both `1` and `raw=1` tokens
    set -l raw_arg "{{raw}}"
    set -l header_arg "{{no_header}}"
    set -l show_raw false
    set -l show_header true
    if test -n "$raw_arg"
        if string match -q 'no_header=*' -- $raw_arg
            set header_arg $raw_arg
        else
            set show_raw true
        end
    end
    test -n "$header_arg"; and set show_header false
    pushd "{{REPO_DIR}}" >/dev/null
        if test -f .cross/metadata.json
            # Get unique remotes used by patches
            set used_remotes (jq -r '.patches[].remote' .cross/metadata.json | sort -u)

            if test (count $used_remotes) -gt 0
                if $show_raw
                    if $show_header
                        printf 'REMOTE_NAME\tREMOTE_URL\n'
                    end
                else
                    just cross _log info "Configured Remotes:"
                    if $show_header
                        printf "%-20s %s\n" "REMOTE NAME" "REMOTE URL"
                        printf "%s\n" (string repeat -n 70 "-")
                    end
                end

                # Deterministic order: remotes sorted, fetch URL first, then push-only URLs
                for name in $used_remotes
                    set -l urls (git remote get-url --all $name 2>/dev/null)
                    for url in (git remote get-url --push --all $name 2>/dev/null)
                        contains $url $urls; or set urls $urls $url
                    end
                    for url in $urls
                        if $show_raw
                            printf '%s\t%s\n' $name $url
                        else
                            printf "%-20s %s\n" $name $url
                        end
                    end
                end

                if not $show_raw
                    echo ""
                end
            end
        end

        if not test -f Crossfile
            if $show_raw
                echo "No patches found, Crossfile missing." >&2
            else
                just cross _log warn "No patches found, Crossfile missing."
            end
            popd >/dev/null
            exit 0
        end

        if $show_raw
            if $show_header
                printf 'REMOTE\tREMOTE_PATH\tLOCAL_PATH\tWORKTREE\tBRANCH\n'
            end
        else
            just cross _log info "Configured Patches:"
            if $show_header
                printf "%-20s %-30s %-20s %-26s %-15s\n" "REMOTE" "REMOTE PATH" "LOCAL PATH" "WORKTREE" "BRANCH"
                printf "%s\n" (string repeat -n 70 "-")
            end
        end

        if test -f .cross/metadata.json
            set -l patch_rows (jq -r '.patches[] | [.remote, .remote_path, .local_path, .worktree, .branch] | @tsv' .cross/metadata.json | sort)
            for row in $patch_rows
                if $show_raw
                    printf '%s\n' $row
                else
                    set -l cols (string split \t -- $row)
                    printf "%-20s %-30s %-20s %-26s %-15s\n" $cols[1] $cols[2] $cols[3] $cols[4] $cols[5]
                end
            end
        else if $show_raw
            echo "No patches found. Run: just cross patch REMOTE_PATH LOCAL_PATH" >&2
        else
            just cross _log info "No patches found. Run: just cross patch REMOTE_PATH LOCAL_PATH"
        end
    popd >/dev/null

# wt wrapper
[no-cd]
worktree path="":
    just cross wt "{{path}}"

# Print a patch worktree to cd into (use: cd (just cross wt [path]))
[no-cd]
wt path="":
    #!/usr/bin/env fish
    set -l resolved_path "{{path}}"
    # Explicit path: make absolute and ./-prefixed paths repo-relative first
    if test -n "$resolved_path"
        if test -e "$resolved_path"
            set -l dir "$resolved_path"
            test -d "$dir"; or set dir (dirname "$dir")
            # git -C: avoid fish's `cd` in a command substitution changing our cwd
            set resolved_path (git -C "$dir" rev-parse --show-prefix 2>/dev/null | sed 's,/$,,')
        else
            set resolved_path (string replace -r '^\./' '' -- "$resolved_path")
        end
    end
    # Resolution ladder: path/CWD auto-detect -> fzf selection -> rows + exit 1
    set -l ctx (just cross _resolve_context2 "$resolved_path" 2>/dev/null)
    if test (count $ctx) -eq 0
        if test -z "$resolved_path"
            if not command -v fzf >/dev/null 2>&1
                just cross _list_patches "fzf is not installed, cd manually. Destinations, columns local_path TAB worktree" >&2
                exit 1
            end
            set -l sel (just cross _select_patch patch)
            test -z "$sel"; and exit 0
            set resolved_path "$sel"
            set ctx (just cross _resolve_context2 "$sel" 2>/dev/null)
        end
        if test (count $ctx) -eq 0
            just cross _list_patches "No patch detected, available patches, columns local_path TAB worktree" >&2
            exit 1
        end
    end
    printf '%s\n' $ctx | source
    echo "{{REPO_DIR}}/$worktree"

# Print a patch local_path to cd into (use: cd (just cross cd [path]))
[no-cd]
cd path="":
    #!/usr/bin/env fish
    set -l resolved_path "{{path}}"
    # Explicit path: make absolute and ./-prefixed paths repo-relative first
    if test -n "$resolved_path"
        if test -e "$resolved_path"
            set -l dir "$resolved_path"
            test -d "$dir"; or set dir (dirname "$dir")
            # git -C: avoid fish's `cd` in a command substitution changing our cwd
            set resolved_path (git -C "$dir" rev-parse --show-prefix 2>/dev/null | sed 's,/$,,')
        else
            set resolved_path (string replace -r '^\./' '' -- "$resolved_path")
        end
    end
    # Resolution ladder: path/CWD auto-detect -> fzf selection -> rows + exit 1
    set -l ctx (just cross _resolve_context2 "$resolved_path" 2>/dev/null)
    if test (count $ctx) -eq 0
        if test -z "$resolved_path"
            if not command -v fzf >/dev/null 2>&1
                just cross _list_patches "fzf is not installed, cd manually. Destinations, columns local_path TAB worktree" >&2
                exit 1
            end
            set -l sel (just cross _select_patch patch)
            test -z "$sel"; and exit 0
            set resolved_path "$sel"
            set ctx (just cross _resolve_context2 "$sel" 2>/dev/null)
        end
        if test (count $ctx) -eq 0
            just cross _list_patches "No patch detected, available patches, columns local_path TAB worktree" >&2
            exit 1
        end
    end
    printf '%s\n' $ctx | source
    echo "{{REPO_DIR}}/$local_path"


# AICONTEXT: "status" shows status of current local_path patch vs. WT, and WT upstream. Input argument is local_path (or understand user stand in the under git-cross'ed local_path and call this comand). It shall be called to get status of local_path from "list" command. Either the status of remote WT upstream (as resource consuming, shall be optional or only ocasional)
# Show status of all patches
[no-cd]
status: check-deps
    #!/usr/bin/env fish
    cd "{{REPO_DIR}}"
    if not test -f Crossfile
        just cross _log warn "No patches found."
        exit 0
    end
    
    printf "%-20s %-15s %-15s %-15s\n" "LOCAL PATH" "DIFF" "UPSTREAM" "CONFLICTS"
    printf "%s\n" (string repeat -n 70 "-")
    
    if test -f .cross/metadata.json
        jq -r '.patches[] | "\(.remote) \(.remote_path) \(.local_path) \(.worktree)"' .cross/metadata.json | while read -l remote rpath local_path wt
            set diff_stat "Clean"
            set upstream_stat "Synced"
            set conflict_stat "No"
            
            if test -d $wt
                # Check diffs
                set overrides (just cross _crossignore_overrides "{{REPO_DIR}}/$local_path")
                if test (count $overrides) -gt 0
                    set diff_stat "Override"
                else if not test -d $local_path
                    set diff_stat "Modified"
                else if test (rsync -rlcn --delete --exclude=.git --itemize-changes "$wt/$rpath/" "$local_path/" 2>/dev/null | count) -gt 0
                    # .git excluded: the worktree pointer file has no local counterpart
                    set diff_stat "Modified"
                end
                
                # Check upstream divergence
                set behind (git -C $wt rev-list --count HEAD..@{upstream} 2>/dev/null)
                set ahead (git -C $wt rev-list --count @{upstream}..HEAD 2>/dev/null)
                if test "$behind" -gt 0
                    set upstream_stat "$behind behind"
                else if test "$ahead" -gt 0
                    set upstream_stat "$ahead ahead"
                end
                
                # Check conflicts in worktree
                if git -C $wt ls-files -u | grep -q .
                    set conflict_stat "YES"
                end
                
                # Also check conflicts in local path (from failed stash restore)
                if git ls-files -u $local_path | grep -q .
                    set conflict_stat "YES"
                end
            else
                set diff_stat "Missing WT"
            end
            
            printf "%-20s %-15s %-15s %-15s\n" $local_path $diff_stat $upstream_stat $conflict_stat
        end
    else
        just cross _log info "No patches found."
    end

# Install git alias for git-cross (impl: go or shell)
install impl="go":
    #!/usr/bin/env bash
    set -e
    export PATH=$HOME/homebrew/bin:$PATH
    case "{{impl}}" in
        go)
            echo "==> Building Go implementation..."
            (cd "{{JUST_DIR}}/src-go" && go build -o git-cross-go main.go)
            EXE="{{JUST_DIR}}/src-go/git-cross-go"
            echo "==> Setting up git alias 'cross' -> $EXE"
            git config --global alias.cross "!$EXE"
            echo "Success: Git alias 'cross' installed."
            ;;
        shell|just)
            CROSS_PATH="{{JUST_DIR}}/Justfile"
            echo "==> Setting up git alias 'cross' -> just --justfile $CROSS_PATH cross"
            git config --global alias.cross "!just --justfile $CROSS_PATH cross"
            echo "Success: Git alias 'cross' installed."
            ;;
        *)
            echo "ERROR: Unknown implementation '{{impl}}'. Use: go or shell."
            exit 1
            ;;
    esac
