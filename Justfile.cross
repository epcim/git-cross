# settings
set export := true
set positional-arguments

# ============================================================================
# git-cross — Just/Fish REFERENCE implementation (v0.5.1 scope)
#
# Go (src-go) is the primary and ONLY full implementation. This file is the
# prototyping / clean-code showcase: CORE commands only — use, set, del, ls,
# cfg/init, and the git passthrough (`just cross <git-args>` -> _gitcmd).
# update, resolve, wipe, comp, shell-init, cd and wt are Go-only stubs that
# answer "NOT IMPLEMENTED in Justfile version" and exit 1.
# Touch this file only for .cross/metadata.json schema changes or core-command
# fixes. Full pre-split reference: Justfile.cross.full-v0.5 (backup, not committed).
# ============================================================================

CROSSFILE := "Crossfile"
CROSSDIR := ".cross"
METADATA := "$CROSSDIR/metadata.json"
JUST_DIR := env("JUST_DIR", source_dir())
REPO_DIR := env ("REPO_DIR", "$(git rev-parse --show-toplevel)")
SHELL := env_var_or_default("SHELL", "bash")

# Auto-setup environment on first use
# AICONTEXT: Optional target to help user to ensure correct setup for tool usage. Taks: Call direnv, loading .envrc and from that .env file. Ideally short implementation. 
setup:
    #!/usr/bin/env fish
    # Check if direnv is available
    if command -v direnv >/dev/null; and test -f .envrc
        if not direnv status | grep -q "Found RC allowed true"
            direnv allow .
        end
    end

# AICONTEXT: Implemented through just -l option. Use comment strings on individual targets to document ussage.
# Show this help message
help:
   just -l

# AICONTEXT: This is for AI tools to execute tests in sanbox environment. Do not change implementation!
# Run test suite in clean environment (optional args: [test_id]: 01, 02, etc)
test *ARGS:
    #!/usr/bin/env bash
    # PRESERVE THESE ENVS
    THOME="$HOME"
    TUSER="$USER"
    TPATH="$PATH"
    TTERM="$TERM"
    BASH="$(command -v bash)"

    if [[ "${1:-}" == "shell" ]]; then
        shift || true
        just --justfile "{{JUST_DIR}}/Justfile.cross" test-shell {{ARGS}}
        exit 0
    fi

    # Run in clean environment with minimal PATH
    #TARG="${ARGS:+--test $ARGS}"
    env -i \
        TARG="$TARG" \
        HOME="$THOME" \
        USER="$TUSER" \
        PATH="$TPATH" \
        SHELL="$BASH" \
        TERM="${TTERM:-xterm}" \
        GIT_CONFIG_NOSYSTEM=1 \
        GIT_CONFIG_GLOBAL=/dev/null \
        "$BASH" --norc --noprofile -c 'cd "{{JUST_DIR}}"; ./test/run-all.sh {{ARGS}}';
    STATUS=$?
    echo "Test exited with $STATUS";
    exit $STATUS

# AICONTEXT: This is for AI tools to execute tests in sanbox environment. Do not change implementation!
# Run "test" shell environment or commands passed as ARGS inside "test shell environment"
test-shell *ARGS="bash":
    #!/usr/bin/env bash
    set -euo pipefail
    THOME="$HOME"
    TUSER="$USER"
    TPATH="$PATH"
    TTERM="$TERM"
    BASH="$(command -v bash)"

    if [[ -t 0 && -t 1 ]]; then
        echo 'Launching git-cross test shell (type CTRL+D to leave)...'
        env -i \
            HOME="$THOME" \
            USER="$TUSER" \
            PATH="$TPATH" \
            SHELL="$BASH" \
            TERM="${TTERM:-xterm}" \
            "$BASH" --norc --noprofile -i -c "{{ARGS}}"
    fi

# AICONTEXT: This methond validate user workspace has installed all required dependencies. Dont install them, but prints how-to.
# Check for required dependencies
check-deps:
    #!/usr/bin/env fish
    set -l missing
    for cmd in fish git jq rg
        if not command -v $cmd > /dev/null
            set missing $missing $cmd
        end
    end
    if test (count $missing) -gt 0
        just cross _log error "Missing: $missing"
        just cross _log info "Install the missing binaries with your package manager."
        exit 1
    end


# AICONTEXT: This is new and better implementation of resolve_context
# Internal: resolve patch metadata from path argument or CWD
[no-cd] # to be able to set CWD as $path if not provided
_resolve_context2 path="":
    #!/usr/bin/env fish

    # Resolve git repo relative path of target
    if test "$path" = "." -o "$path" = "./"
        # "." means the caller's directory — same as no path
        set path ""
    end
    if test -z "$path"
        # Use USER_CWD (set by root Justfile cross recipe) to preserve caller's CWD
        if test -n "$USER_CWD" -a -n "$REPO_DIR"
            set -x path (realpath --relative-to="$REPO_DIR" "$USER_CWD" 2>/dev/null; or echo "")
            # "." means we're at repo root — treat as empty
            if test "$path" = "."
                set -x path ""
            end
        end
        if test -z "$path"
            set -x path "$(git rev-parse --show-prefix | sed 's,\/$,,')"
        end
    end
    if test -z "$path"
        just cross _log error "Provide path to 'patch' or change directory into it."
        exit 1
    end
    # Query metadata.json and export matching key as env variables
    # Find patch whose local_path is a prefix of (or equal to) the given path
    # i.e. path starts with local_path — handles both exact match and subdirectory cases.
    # Paths are normalized ("^\\./" stripped) so "./mxc2" in metadata still matches "mxc2".
    jq -r --arg path "$path" '
        .patches
        | map(. as $patch
              | ($patch.local_path | ltrimstr("./")) as $lp
              | ($path | ltrimstr("./")) as $p
              # v0.5.1: path-segment aware — a sibling dir sharing only a name
              # prefix (infra/ipxex vs infra/ipxe) is NOT patch context.
              | select($p == $lp or ($p | startswith($lp + "/")))
              | $patch + {mlen: ($lp | length)})
        | max_by(.mlen)
        | select(. != null)
        | del(.mlen)
        | to_entries | map("set -x \(.key) \(.value|@sh)") | .[]
        ' "{{REPO_DIR}}/{{METADATA}}"

# AICONTEXT: This method updates Crossfile, an configuration file for git-cross. Do not change implementation!
# Internal: append command to Crossfile (avoiding duplicates)
update_crossfile +cmd:
    @grep -qF "{{cmd}}" "{{CROSSFILE}}" 2>/dev/null || echo "{{cmd}}" >> "{{CROSSFILE}}"; exit 0

# Internal: Log message with color
_log level +message:
    #!/usr/bin/env fish
    set color_reset (set_color normal)
    switch {{level}}
        case info
            set color (set_color blue)
            echo "$color==> {{message}}$color_reset"
        case success
            set color (set_color green)
            echo "$color==> {{message}}$color_reset"
        case warn
            set color (set_color yellow)
            echo "$color==> WARNING: {{message}}$color_reset" >&2
        case error
            set color (set_color red)
            echo "$color==> ERROR: {{message}}$color_reset" >&2
        case '*'
            echo "==> {{message}}"
    end

# Internal: print TSV rows aligned on a terminal, unchanged (TAB) when piped.
[no-cd]
_print_rows:
    #!/usr/bin/env fish
    if not test -t 1
        cat
        return
    end
    awk -F'\t' '
        { for (i = 1; i <= NF; i++) if (length($i) > w[i]) w[i] = length($i); rows[NR] = $0 }
        END {
            for (r = 1; r <= NR; r++) {
                n = split(rows[r], a, "\t"); line = ""
                for (i = 1; i <= n; i++)
                    line = line (i < n ? sprintf("%-*s  ", w[i], a[i]) : a[i])
                print line
            }
        }'

# Print one row per patch: local_path<TAB>worktree (machine-parseable).
# hint is variadic because the Justfile wrapper word-splits arguments.
[no-cd]
_list_patches *hint="":
    #!/usr/bin/env fish
    if not test -f "{{REPO_DIR}}/.cross/metadata.json"
        just cross _log info "No patches configured."
        exit 0
    end
    set -l hint_text "{{hint}}"
    if test -n "$hint_text"
        echo "$hint_text" >&2
    end
    jq -r '.patches[] | "\(.local_path)\t\(.gitdir)"' "{{REPO_DIR}}/.cross/metadata.json"

# Configure the repo for git-cross: Crossfile + rerere + .gitignore (`init` kept as alias)
[no-cd]
cfg:
    #!/usr/bin/env fish
    # Remember conflict resolutions for later updates (repo config, not global).
    set -l repo (git rev-parse --show-toplevel 2>/dev/null)
    if test -n "$repo"
        set -l rerere (git -C $repo config --get rerere.enabled 2>/dev/null | string trim)
        if test "$rerere" = true
            just cross _log info "rerere already enabled: conflict resolutions are reused."
        else
            git -C $repo config rerere.enabled true
            and just cross _log info "Enabled rerere: conflict resolutions are remembered for later updates."
        end
    end
    # .cross/ is disposable state - make sure the repo does not track it.
    if not grep -qxF '.cross/' {{REPO_DIR}}/.gitignore 2>/dev/null
        if test -f {{REPO_DIR}}/.gitignore; and test -s {{REPO_DIR}}/.gitignore; and not string match -q '' (tail -c1 {{REPO_DIR}}/.gitignore)
            echo '' >> {{REPO_DIR}}/.gitignore
        end
        echo '.cross/' >> {{REPO_DIR}}/.gitignore
    end
    if test -f "{{CROSSFILE}}"
        just cross _log info "Crossfile already exists."
    else
        echo "# git-cross configuration" > "{{CROSSFILE}}"
        just cross _log success "Crossfile initialized."
        if test (basename $SHELL 2>/dev/null) = fish
            just cross _log info "Shell integration (xcd + gx/cr aliases): git cross comp fish | source"
        else
            just cross _log info 'Shell integration (xcd + gx/cr aliases): eval \"\$(git cross comp)\"'
        end
    end

# Alias of cfg (kept: `git cross init` never shadows native git init — you cannot
# run git cross inside an uninitialized repository, chicken-egg).
[no-cd]
init:
    just cross cfg

# Internal: gitdir path for a patch: .cross/worktrees/<remote>/<local_path slashes->underscores>
[no-cd]
_patch_gitdir remote local_path:
    #!/usr/bin/env fish
    set -l lp (string replace -a './' '' "{{local_path}}" | string replace -a / _)
    echo ".cross/worktrees/{{remote}}/$lp"

# Internal: resolve a remote name to its URL from metadata (v2: remotes live
# in .cross/metadata.json, not in the primary repo's git config).
[no-cd]
_remote_url remote:
    #!/usr/bin/env fish
    set -l url (jq -r --arg n "{{remote}}" '.remotes[]? | select(.name == $n) | .url' "{{REPO_DIR}}/{{METADATA}}" 2>/dev/null)
    test -n "$url"; and echo "$url"; or exit 1

# AICONTEXT: "use" registers remote git repository URL in .cross/metadata.json (remotes
# section) and Crossfile. The primary repo's git remotes are NOT touched (v2).
# Add a remote repository
[no-cd]
use name url: check-deps
    #!/usr/bin/env fish
    cd "{{REPO_DIR}}"
    # Validate the URL is reachable (also warms up branch detection).
    # </dev/null: ssh-spawning git reads stdin otherwise and would drain a
    # piped stdin before any later consumer needs it.
    if not git ls-remote --heads {{url}} </dev/null >/dev/null 2>&1
        just cross _log error "Cannot reach remote: {{url}}"
        exit 1
    end
    # Initialize metadata with v2 shape when missing
    if not test -f {{METADATA}}
        mkdir -p (dirname {{METADATA}})
        echo '{"remotes": [], "patches": []}' > {{METADATA}}
    end
    set tmp (mktemp)
    jq --arg n "{{name}}" --arg u "{{url}}" \
        'if .remotes == null then .remotes = [] else . end | .remotes |= (map(select(.name != $n)) + [{name: $n, url: $u}])' \
        {{METADATA}} > "$tmp"; and mv "$tmp" {{METADATA}}
    just cross update_crossfile "cross use {{name}} {{url}}"
    just cross _log success "Remote {{name}} registered ({{url}})."

# Delete a cross and its crossed directory
[no-cd]
del path: check-deps
    #!/usr/bin/env fish
    set l_path (path normalize "{{path}}")
    pushd "{{REPO_DIR}}"
        if not test -f {{METADATA}}
            just cross _log error "No metadata found."
            exit 1
        end

        set entry (jq -r --arg lp "$l_path" '.patches[] | select((.local_path | ltrimstr("./")) == $lp)' {{METADATA}})
        if test -z "$entry"
            just cross _list_patches "No cross detected, available crosses, columns local_path TAB gitdir"
            just cross _log error "Cross not found for path: $l_path"
            exit 1
        end

        set gd (echo "$entry" | jq -r '.gitdir')

        just cross _log info "Removing cross at $l_path..."

        # 1. Remove from Crossfile (match patch lines where last field is the local_path)
        just cross _log info "Removing from Crossfile..."
        if test -f "{{CROSSFILE}}"
            set tmp (mktemp)
            while read -l line
                # Only remove lines that are patch commands with this exact local_path as last field
                set fields (string split ' ' -- (string trim $line))
                set is_cross false
                for f in $fields
                    test "$f" = "set" -o "$f" = "patch"; and set is_cross true
                end
                if test "$is_cross" = true -a (count $fields) -gt 0 -a (path normalize "$fields[-1]") = "$l_path"
                    continue  # skip this line
                end
                echo "$line" >> "$tmp"
            end < "{{CROSSFILE}}"
            mv "$tmp" "{{CROSSFILE}}"
        end

        # 2. Update metadata
        just cross _log info "Updating metadata..."
        set tmp_meta (mktemp)
        jq --arg lp "$l_path" '.patches |= map(select((.local_path | ltrimstr("./")) != $lp))' {{METADATA}} > "$tmp_meta"
        mv "$tmp_meta" {{METADATA}}

        # 3. Remove the per-patch gitdir (v2: one standalone gitdir per patch, no sharing)
        if test -d "{{REPO_DIR}}/$gd"
            just cross _log info "Removing gitdir at $gd..."
            rm -rf "{{REPO_DIR}}/$gd"
        end

        # 4. Remove local directory (with root guard)
        if test "$l_path" != "." -a -n "$l_path"
            just cross _log info "Deleting local directory $l_path..."
            rm -rf "$l_path"
        end

        just cross _log success "Cross deleted successfully."
    popd

# v0.5.1: Go-only command. Placeholder stub — see the header note.
[no-cd]
wipe remote_name="":
    @echo "NOT IMPLEMENTED in Justfile version: wipe — Go-only, use: git cross wipe" >&2; exit 1
# v2: each patch is a standalone bare gitdir under .cross/worktrees/<remote>/<local_path>;
# the work tree is local_path itself, inside the primary repo — no rsync, no linked worktrees.
# AICONTEXT: for implementation, use "fish" keep it simple, shell comamnds shall be readable. User interaction shall be kept minimal. Debug statements are not needed. Document in comments major logical blocks.
# Set a cross directory: vendor a remote repository path into a local path
set remote_spec local_path="": check-deps
    #!/usr/bin/env fish
    set parts (string split : {{remote_spec}})
    switch (count $parts)
        case 3
            set remote $parts[1]
            set remote_branch $parts[2]
            set remote_path $parts[3]
        case 2
            set remote $parts[1]
            set remote_path $parts[2]
        case '*'
            just cross _log error "Error: Invalid format. Use remote[:branch]:remote_path LOCAL_PATH"
            exit 1
    end

    # update vars — treat "/" as "." (whole repo root)
    set r_path (string trim -c '/' -- "$remote_path")
    test -n "$r_path"; or set r_path "."

    set l_path "{{local_path}}"
    if test -z "$l_path" -a "$r_path" = "."
        just cross _log error "Error: local_path is required when setting whole repo, path is '.'"
        exit 1
    end
    test -n "$l_path"; or set l_path "$r_path"
    # Normalize the local path so "./mxc2" is stored/matched as "mxc2"
    set l_path (path normalize "$l_path")

    pushd "{{REPO_DIR}}"
        # resolve remote URL from metadata (v2: remotes live in metadata, not in the primary repo)
        set url (just cross _remote_url $remote)
        if test -z "$url"
            just cross _log error "Remote '$remote' is not registered. Run: git cross use $remote <url>"
            exit 1
        end

        # validate target branch (ls-remote </dev/null: it must not eat stdin)
        if test -z "$remote_branch"
            set remote_branch "master"
            if git ls-remote --heads $url </dev/null | grep -q "refs/heads/main"
                set remote_branch "main"
            end
        end

        set gd (just cross _patch_gitdir $remote $l_path)
        set gd_abs "{{REPO_DIR}}/$gd"

        # already registered? -> suggest update instead of re-installing
        if jq -e --arg lp "$l_path" '(.patches // []) | any(.local_path == $lp)' {{METADATA}} >/dev/null 2>&1
            just cross _log info "Cross already registered at $l_path. Refresh it with: git cross update $l_path"
            exit 0
        end
        # gitdir name collision from a different local_path? refuse
        if jq -e --arg gd "$gd" --arg lp "$l_path" '(.patches // []) | any(.gitdir == $gd and .local_path != $lp)' {{METADATA}} >/dev/null 2>&1
            just cross _log error "Gitdir $gd already used by another cross. Delete it first: git cross del <path>"
            exit 1
        end

        # not registered but the dir is already there: never silently overwrite it
        # (update --force wipes it first, so this only fires on a direct `set`)
        if test -e "{{REPO_DIR}}/$l_path"
            just cross _log error "Local path $l_path exists but is not registered; refusing to overwrite it (add it to Crossfile and run: git cross update --force — or remove the directory)"
            exit 1
        end

        # bare clone + sparse config + materialize the work tree in place
        if not test -d "$gd_abs"
            just cross _log info "Cloning upstream into $gd (bare)..."
            set -l clone_opts --bare
            # opt-in shallow/partial clone via git config cross.depth / cross.filter
            set -l depth (git config --get cross.depth 2>/dev/null | string trim)
            test -n "$depth"; and set -a clone_opts --depth $depth
            set -l filter (git config --get cross.filter 2>/dev/null | string trim)
            test -n "$filter"; and set -a clone_opts --filter $filter
            mkdir -p (dirname "$gd_abs") "$l_path"
            if not git clone $clone_opts --branch $remote_branch $url "$gd_abs" </dev/null
                just cross _log error "git clone failed for $remote ($url)"
                exit 1
            end
            # remember conflict resolutions in this standalone gitdir
            git --git-dir="$gd_abs" config rerere.enabled true
            if test "$r_path" != "."
                # sparse filter: trailing "/" matches the directory reliably in --no-cone mode
                git --git-dir="$gd_abs" config core.sparseCheckout true
                echo "$r_path/" > "$gd_abs/info/sparse-checkout"
            end
            git --git-dir="$gd_abs" --work-tree="{{REPO_DIR}}/$l_path" read-tree -mu HEAD
        else if not test -d "{{REPO_DIR}}/$l_path"
            # orphaned gitdir (e.g. metadata was lost): re-materialize only
            just cross _log info "Reusing existing gitdir $gd"
            mkdir -p "$l_path"
            git --git-dir="$gd_abs" --work-tree="{{REPO_DIR}}/$l_path" read-tree -mu HEAD
        end

        # Ensure .cross/ is in .gitignore
        if not grep -qxF '.cross/' .gitignore 2>/dev/null
            if test -f .gitignore; and test -s .gitignore; and not string match -q '' (tail -c1 .gitignore)
                echo '' >> .gitignore
            end
            echo '.cross/' >> .gitignore
        end

        # Add local_path to git (primary tracks patch files as normal files)
        git add $l_path

        # update Crossfile
        just cross _log info "Update Crossfile"
        just cross update_crossfile "cross set $remote:$remote_branch:$r_path $l_path"

        # Update metadata.json (v2: local_path/worktree/gitdir + remote_url; dedup by local_path)
        # ADR-001: all locations are stored repo-relative; worktree == local_path today.
        if not test -f {{METADATA}}
            mkdir -p (dirname {{METADATA}})
            echo '{"remotes": [], "patches": []}' > {{METADATA}}
        end
        set new_entry (jq -n --arg remote "$remote" --arg url "$url" --arg rp "$r_path" --arg lp "$l_path" --arg wt "$l_path" --arg gd "$gd" --arg br "$remote_branch" \
            '{remote: $remote, remote_url: $url, remote_path: $rp, local_path: $lp, worktree: $wt, gitdir: $gd, branch: $br}')
        set tmp_file (mktemp)
        jq --arg lp "$l_path" --argjson entry "$new_entry" \
            'if .remotes == null then .remotes = [] else . end | .patches |= (map(select((.local_path | ltrimstr("./")) != $lp)) + [$entry])' \
            "{{METADATA}}" > "$tmp_file"
        mv "$tmp_file" "{{METADATA}}"
        
    popd

# v0.5.1: update/resolve are Go-only. The Just/Fish reference implements the
# CORE commands only; the full update/resolve flow (ADR-003: fetch-all, 3-way
# cherry-pick apply, rerere) lives in the Go CLI. Mechanics: AGENTS.md and
# specs/003-gitdir-patches; the pre-split fish code: Justfile.cross.full-v0.5.
[no-cd]
update *args:
    @echo "NOT IMPLEMENTED in Justfile version: update — Go-only, use: git cross update" >&2; exit 1

[no-cd]
resolve *args:
    @echo "NOT IMPLEMENTED in Justfile version: resolve — Go-only, use: git cross resolve" >&2; exit 1

# AICONTEXT: "list" lists remotes used by patches and all patches from .cross/metadata.json
# (worktrees live under .cross/worktrees/). raw: TSV rows with no banners/borders;
# no_header: omit header lines. Output order is fixed: remotes first, then patches.
# Usage: ls [raw] [no_header]  (e.g. `just cross ls 1`, `just cross ls raw=1 no_header=1`)
# List all remotes and crosses
[no-cd]
ls raw="" no_header="": check-deps
    #!/usr/bin/env fish
    # just binds recipe parameters positionally; tolerate both `1` and `raw=1` tokens
    set -l raw_arg "{{raw}}"
    set -l header_arg "{{no_header}}"
    set -l show_raw false
    set -l show_header true
    if test -n "$raw_arg"
        if string match -q 'no_header=*' -- $raw_arg
            set header_arg $raw_arg
        else
            set show_raw true
        end
    end
    test -n "$header_arg"; and set show_header false
    pushd "{{REPO_DIR}}" >/dev/null
        if test -f .cross/metadata.json
            # v2: remotes live in metadata (.remotes), not in the primary repo's git config
            set used_remotes (jq -r '.remotes[]?.name' .cross/metadata.json | sort -u)

            if test (count $used_remotes) -gt 0
                set -l remote_rows
                if $show_raw
                    if $show_header
                        set -a remote_rows (string join \t -- REMOTE_NAME REMOTE_URL)
                    end
                else
                    just cross _log info "Configured Remotes:"
                    if $show_header
                        printf "%-20s %s\n" "REMOTE NAME" "REMOTE URL"
                        printf "%s\n" (string repeat -n 70 "-")
                    end
                end

                # Deterministic order: remotes sorted
                for name in $used_remotes
                    set -l url (jq -r --arg n "$name" '.remotes[]? | select(.name == $n) | .url' .cross/metadata.json)
                    if test -n "$url"
                        if $show_raw
                            set -a remote_rows (string join \t -- $name $url)
                        else
                            printf "%-20s %s\n" $name $url
                        end
                    end
                end

                if $show_raw
                    if test (count $remote_rows) -gt 0
                        printf '%s\n' $remote_rows | just cross _print_rows
                    end
                else
                    echo ""
                end
            end
        end

        if not test -f Crossfile
            if $show_raw
                echo "No crosses found, Crossfile missing." >&2
            else
                just cross _log warn "No crosses found, Crossfile missing."
            end
            popd >/dev/null
            exit 0
        end

        set -l patch_rows
        if test -f .cross/metadata.json
            # DIFF column: crossed dir vs the mirror's HEAD — the old `stat`
            # logic (throwaway index, mapped subtree only). Go: crossDiffState.
            function _diff_state --argument-names lp rp gd
                set -l root "{{REPO_DIR}}"
                if not test -d "$root/$lp"
                    echo Missing Files
                    return
                end
                if not test -d "$root/$gd"
                    echo Missing GD
                    return
                end
                test -z "$rp" -o "$rp" = /; and set rp .
                set -l idx (mktemp -u)
                if not GIT_INDEX_FILE="$idx" git --git-dir="$root/$gd" read-tree HEAD 2>/dev/null
                    echo Error   # unreadable gitdir — Go's error path says Error too
                    rm -f "$idx"
                    return
                end
                # The mirror is BARE: GIT_WORK_TREE must name the crossed dir or git
                # refuses the diff ("must be run in a work tree") — the v0.5.1 Go
                # bugfix added the same work tree to its health diff.
                if not GIT_INDEX_FILE="$idx" GIT_WORK_TREE="$root/$lp" git --git-dir="$root/$gd" -C "$root/$lp" diff --quiet HEAD -- "$rp"
                    echo Modified
                else
                    echo Clean
                end
                rm -f "$idx"
            end

            # SHA column: short upstream HEAD the mirror has checked out
            # (rev-parse only, no fetch). Depends on the gitdir alone.
            function _short_sha --argument-names gd
                set -l sha (git --git-dir="{{REPO_DIR}}/$gd" rev-parse --short HEAD 2>/dev/null | string trim)
                test -n "$sha"; and echo $sha; or echo "-"
            end

            # base rows: REMOTE, REMOTE_PATH, LOCAL_PATH, WORKTREE, GITDIR, BRANCH
            set -l base_rows (jq -r '.patches[] | [.remote, .remote_path, .local_path, (.worktree // .local_path), .gitdir, .branch] | @tsv' .cross/metadata.json | sort)
            for row in $base_rows
                set -l c (string split \t -- $row)
                set -l rp $c[2]
                set -l lp $c[3]
                set -l wt $c[4]
                set -l gd $c[5]
                string match -q '.cross/worktrees/*' -- $wt; and set wt $lp   # v0.4 self-heal
                set -a patch_rows (string join \t -- $c[1] $rp $lp $wt $gd $c[6] (_diff_state $lp $rp $gd) (_short_sha $gd))
            end
            if $show_raw
                if $show_header
                    set patch_rows (string join \t -- REMOTE REMOTE_PATH LOCAL_PATH WORKTREE GITDIR BRANCH DIFF SHA) $patch_rows
                end
                if test (count $patch_rows) -gt 0
                    printf '%s\n' $patch_rows | just cross _print_rows
                end
            else
                just cross _log info "Configured crosses:"
                if $show_header
                    printf "%-20s %-30s %-20s %-20s %-26s %-15s %-13s %-10s\n" "REMOTE" "REMOTE PATH" "LOCAL PATH" "WORKTREE" "GITDIR" "BRANCH" "DIFF" "SHA"
                    printf "%s\n" (string repeat -n 70 "-")
                end
                for row in $patch_rows
                    set -l cols (string split \t -- $row)
                    printf "%-20s %-30s %-20s %-20s %-26s %-15s %-13s %-10s\n" $cols[1] $cols[2] $cols[3] $cols[4] $cols[5] $cols[6] $cols[7] $cols[8]
                end
            end
        else if $show_raw
            echo "No crosses found. Run: just cross set REMOTE_PATH LOCAL_PATH" >&2
        else
            just cross _log info "No crosses found. Run: just cross set REMOTE_PATH LOCAL_PATH"
        end
    popd >/dev/null


# Internal: closest cross command for a mistyped first word (empty output =
# no guess). Mirrors Go suggestCrossCommand exactly:
#   - words shorter than 2 chars and real git commands never guess,
#   - a candidate matches when it prefixes the word, the word prefixes it,
#     or its letters appear in the word in order (subsequence, "c*o*m*p"),
#   - the longest candidate wins; an exact cross name never guesses.
[no-cd]
_suggest_command word="":
    #!/usr/bin/env fish
    set -l in (string trim -- "{{word}}")
    if test (string length -- "$in") -lt 2
        exit 0
    end
    if contains -- $in status log diff add commit push pull fetch rebase merge branch tag checkout remote clone stash show grep restore switch rm mv reset clean init
        exit 0
    end
    set -l best ""
    for name in use set del cfg update resolve ls cd wt comp wipe list completion init shell-init help
        if test "$in" = "$name"
            exit 0
        end
        set -l seq "*"({string join '*' -- (string split '' -- $name)})"*"   # subsequence glob
        if string match -q -- "$name*" $in
            or string match -q -- "$in*" $name
            or string match -q -- $seq $in
            and test (string length -- "$name") -gt (string length -- "$best")
            set best $name
        end
    end
    echo $best

# v3: _gitcmd is the git passthrough for the crossed dir's upstream context —
# resolves the cross from the current directory and runs git with
# GIT_DIR/GIT_WORK_TREE pointing at the cross gitdir + crossed directory.
# Not inside a crossed dir => no GIT_DIR/GIT_WORK_TREE to configure: fail early
# instead of silently operating on the primary repo (git cross pull at the root
# would otherwise pull THIS repository). This is what the bare
# `git cross <git-args>` fall-through runs.
# Usage (stand inside the crossed directory): git cross status / log / push / ...
[no-cd]
_gitcmd *args:
    #!/usr/bin/env fish
    set -l rel (git rev-parse --show-prefix 2>/dev/null | string trim -r -c '/')
    set -l ctx (just cross _resolve_context2 "$rel" 2>/dev/null)
    if test (count $ctx) -eq 0
        # No crossed dir => no GIT_DIR/GIT_WORK_TREE to configure: fail early
        # instead of silently operating on the primary repo. A mistyped cross
        # command gets a suggestion instead of the generic hint.
        set -l guess (just cross _suggest_command "$argv[1]")
        if test -n "$guess"
            just cross _log error "'$argv[1]' is not a git-cross command (did you mean: $guess?)"
            echo "  see: git cross --help    (inside a crossed dir, 'git cross <git-args>' runs git on its upstream)" >&2
            exit 1
        end
        just cross _log error "not inside a crossed directory: 'git cross <git-args>' runs git on the crossed dir's upstream and needs one"
        echo "  cd into a crossed dir first:  xcd [path] (wrapper from: git cross comp; git cross cd prints the path)" >&2
        echo "  for THIS repository use plain 'git' instead of 'git cross'" >&2
        exit 1
    end
    printf '%s\n' $ctx | source
    set -l gd_abs "{{REPO_DIR}}/$gitdir"
    set -l lp_abs "{{REPO_DIR}}/$local_path"
    # CROSS_DEBUG=1: print the resolved context and the exact git invocation
    # (the Go CLI's --debug prints the same shape).
    if test "$CROSS_DEBUG" = 1
        echo "[cross] patch=$local_path GIT_DIR=$gd_abs GIT_WORK_TREE=$lp_abs" >&2
        echo "[cross] git $argv" >&2
    end
    # $argv (not {{args}}): keeps multi-word arguments intact (e.g. commit -m "a b")
    GIT_DIR="$gd_abs" GIT_WORK_TREE="$lp_abs" git $argv
    exit $status

# v0.5.1: Go-only alias (was: alias of cd). Stub.
[no-cd]
wt path="":
    @echo "NOT IMPLEMENTED in Justfile version: wt — Go-only, use: git cross wt" >&2; exit 1
# v0.5.1: Go-only command (hidden compat twin of comp). Stub.
[no-cd]
shell-init shell="":
    @echo "NOT IMPLEMENTED in Justfile version: shell-init — Go-only, use: git cross comp" >&2; exit 1
# v0.5.1: Go-only command. Stub — the Go CLI prints the real completions + wrappers.
[no-cd]
comp shell="":
    @echo "NOT IMPLEMENTED in Justfile version: comp — Go-only, use: git cross comp" >&2; exit 1
# Legacy alias of comp.
[private]
completion shell="":
    @just cross comp {{shell}}

# v0.5.1: Go-only command. Placeholder stub — see the header note.
[no-cd]
cd path="":
    @echo "NOT IMPLEMENTED in Justfile version: cd — Go-only, use: git cross cd" >&2; exit 1
# Install git alias for git-cross (impl: go or shell)
install impl="go":
    #!/usr/bin/env bash
    set -e
    export PATH=$HOME/homebrew/bin:$PATH
    case "{{impl}}" in
        go)
            echo "==> Building Go implementation..."
            (cd "{{JUST_DIR}}/src-go" && go build -o git-cross-go main.go)
            EXE="{{JUST_DIR}}/src-go/git-cross-go"
            echo "==> Setting up git alias 'cross' -> $EXE"
            git config --global alias.cross "!$EXE"
            git config --global alias.x '!git cross'
            echo "Success: Git aliases 'cross' and 'x' installed."
            ;;
        shell|just)
            CROSS_PATH="{{JUST_DIR}}/Justfile"
            echo "==> Setting up git alias 'cross' -> just --justfile $CROSS_PATH cross"
            git config --global alias.cross "!just --justfile $CROSS_PATH cross"
            git config --global alias.x '!git cross'
            echo "Success: Git aliases 'cross' and 'x' installed."
            ;;
        *)
            echo "ERROR: Unknown implementation '{{impl}}'. Use: go or shell."
            exit 1
            ;;
    esac
