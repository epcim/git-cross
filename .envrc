# direnv - load environment variables for this repo
source_up

# If .env exists, source it (direnv will evaluate this file automatically)
test -f "$(pwd)/.env" && source "$(pwd)/.env" || true

# Harness wiring (PI_CODING_AGENT_DIR / PIG_CODING_AGENT_DIR / OPENCODE_CONFIG)
# belongs in the sbxenv.yaml `env:` block, not here: sbx env does not read
# .envrc, so a variable set here never reaches the sandbox.

# Export sbx secrets
which sbx &>/dev/null && test -e sbxenv.yaml &&\
  eval "$(sbx secrets ls --format json | jq -r '.custom_secrets[] | "export \(.env)=\(.placeholder)"')"

# Shared kit source root for reference when editing sbxenv.yaml.
# export SBX_KITS_DIR="$HOME/.config/sbx-kits"

# Docker Hub namespace for publishing managed V3 kits with sbx-kit-publish.
# export KIT_REGISTRY=docker.io/epcim
